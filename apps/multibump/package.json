{
  "name": "multibump-public",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=build",
    "test": "node --test ../../tests/multibump-public.test.mjs",
    "test:browser": "node ../../tests/multibump-public-browser.mjs",
    "migrate:local": "wrangler d1 migrations apply multibump-public --local",
