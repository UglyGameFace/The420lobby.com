{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "multibump-public",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-22",
  "workers_dev": false,
  "vars": {"PUBLIC_ORIGIN": "https://bump.the420lobby.com"},
  "routes": [{"pattern":"bump.the420lobby.com","custom_domain":true}],
  "triggers": {"crons":["* * * * *"]},
  "d1_databases": [{"binding":"DB","database_name":"multibump-public","database_id":"fe41c813-2d54-4d55-bd25-485440a9695f","migrations_dir":"migrations"}],
  "observability": {"enabled":true}
}
